---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  titulo="Página no encontrada"
  descripcion="La página que buscas no existe o ha cambiado de dirección."
  noindex
>
  <div class="contenedor py-16 sm:py-24">
    <p aria-hidden="true" class="texto-cmyk text-7xl font-extrabold tracking-tighter sm:text-8xl">404</p>
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">Esta página no existe</h1>
    <p class="mt-4 max-w-xl text-lg text-tinta-suave">
      Puede que el enlace esté mal escrito o que la página haya cambiado de dirección. Prueba a
      empezar desde aquí:
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="inline-flex min-h-12 items-center justify-center rounded-full bg-tinta px-6 py-3 font-bold text-papel transition-colors hover:bg-tinta/85"
      >
        Ir al inicio
      </a>
      <a
        href="/trabajos/"
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border-2 border-tinta px-6 py-3 font-bold transition-colors hover:bg-tinta hover:text-papel"
      >
        Ver trabajos
        <ArrowRight class="size-5" />
      </a>
    </div>
  </div>
</BaseLayout>
