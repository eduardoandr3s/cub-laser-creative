---
import { iconos } from '../../config/iconos';
import { inicio } from '../../config/inicio';
import { negocio } from '../../config/negocio';

// Fondo del icono y color del icono, alternando las tintas de la marca con contraste suficiente.
const estilos = ['bg-cian text-tinta', 'bg-magenta text-white', 'bg-ambar text-tinta'];
---

<section aria-labelledby="titulo-diferenciales" class="contenedor py-16 sm:py-20">
  <h2 id="titulo-diferenciales" class="text-3xl font-extrabold tracking-tight">
    ¿Por qué {negocio.nombre}?
  </h2>
  <div class="franja-cmyk mt-3 h-1 w-16 rounded-full"></div>

  <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      inicio.diferenciales.map(({ icono, titulo, texto }, i) => {
        const Icono = iconos[icono];
        return (
          <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-tinta/5">
            <span class:list={['flex size-12 items-center justify-center rounded-xl', estilos[i % estilos.length]]}>
              <Icono class="size-6" />
            </span>
            <h3 class="mt-4 text-lg font-bold">{titulo}</h3>
            <p class="mt-2 text-tinta-suave">{texto}</p>
          </li>
        );
      })
    }
  </ul>
</section>
