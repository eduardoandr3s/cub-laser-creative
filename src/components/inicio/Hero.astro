---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { inicio } from '../../config/inicio';
import { negocio } from '../../config/negocio';
import BotonWhatsApp from '../BotonWhatsApp.astro';
---

<section class="relative overflow-hidden bg-madera">
  <!-- Decoración: tintas cian, magenta y ámbar superpuestas, como en la impresión a color. -->
  <div aria-hidden="true" class="pointer-events-none absolute top-1/2 right-[-6rem] hidden -translate-y-1/2 lg:block">
    <div class="relative size-[26rem] opacity-50">
      <span class="absolute top-0 left-16 size-60 rounded-full bg-cian mix-blend-multiply"></span>
      <span class="absolute top-28 left-0 size-60 rounded-full bg-magenta mix-blend-multiply"></span>
      <span class="absolute top-28 left-32 size-60 rounded-full bg-ambar mix-blend-multiply"></span>
    </div>
  </div>

  <div class="contenedor relative py-14 sm:py-20 lg:py-28">
    <p class="text-sm font-bold tracking-[0.16em] text-cian-texto uppercase">{negocio.eslogan}</p>
    <h1
      class="mt-3 max-w-2xl text-[2rem] leading-[1.1] font-extrabold tracking-tight text-balance sm:text-5xl lg:text-6xl"
    >
      {inicio.hero.titular}
    </h1>
    <p class="mt-5 max-w-xl text-lg text-tinta-suave">{inicio.hero.subtitulo}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <BotonWhatsApp />
      <a
        href="/trabajos/"
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border-2 border-tinta px-6 py-3 font-bold transition-colors hover:bg-tinta hover:text-papel"
      >
        Ver trabajos
        <ArrowRight class="size-5" />
      </a>
    </div>
  </div>
</section>
